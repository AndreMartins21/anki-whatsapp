{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make type)",
      "Bash(make check)",
      "Bash(docker compose config:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(shellcheck:*)",
      "Bash(bash -n:*)",
      "Bash(gcloud config get-value:*)",
      "Bash(gcloud projects describe:*)",
      "Bash(gcloud services list:*)",
      "Bash(gcloud compute instances list:*)",
      "Bash(gcloud compute instances describe:*)",
      "Bash(gcloud iam service-accounts list:*)",
      "Bash(gcloud secrets list:*)",
      "Bash(gcloud secrets describe:*)",
      "Bash(gcloud storage buckets describe:*)",
      "Bash(gcloud storage ls:*)",
      "Bash(gcloud logging read:*)",
      "Bash(gcloud billing accounts list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./infra/.env.infra)",
      "Read(./**/*-key.json)",
      "Read(./**/service-account*.json)",
      "Bash(gcloud secrets versions access:*)",
      "Bash(cat .env:*)",
      "Bash(cat infra/.env.infra:*)"
    ],
    "ask": [
      "Bash(gcloud compute ssh:*)",
      "Bash(gcloud compute scp:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)"
    ]
  }
}
