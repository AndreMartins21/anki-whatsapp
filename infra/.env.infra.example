# Valores NÃO secretos usados pelos scripts de infraestrutura.
# `cp infra/.env.infra.example infra/.env.infra` e preencha. O .env.infra não é versionado.
# Segredos (WAHA_API_KEY, WAHA_DASHBOARD_PASSWORD, ANTHROPIC_API_KEY) vivem no Secret
# Manager e nunca aparecem aqui nem na tela.

GCP_PROJECT_ID=
ALLOWED_NUMBER=      # número pessoal do usuário (o dono do bot), só dígitos
ALLOWED_NUMBERS=     # opcional (M14): alunos, separados por vírgula, só dígitos
ALLOWED_GROUPS=      # opcional (M14): ids de grupo (@g.us) autorizados, separados por vírgula
OWNER_NUMBER=        # opcional (M14): o dono; padrão = ALLOWED_NUMBER
MAX_GROUPS=          # opcional (M15): teto de grupos ativados por admin (padrão 10)
CONTACT_EMAIL=       # opcional (M15): e-mail mostrado a quem não tem plano
BOT_NUMBER=          # número Vivo do bot, só dígitos
LLM_PROVIDER=vertex_gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_EVAL=
VERTEX_LOCATION=global
USER_LEVEL=B1-B2
TIMEZONE=America/Sao_Paulo
