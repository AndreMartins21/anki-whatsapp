# Cópia deste arquivo: `cp .env.example .env` e preencha com valores FALSOS para
# desenvolvimento local. O `.env` real nunca é versionado (ver .gitignore).
# Em produção o arquivo é renderizado na VM a partir do Secret Manager (infra/deploy.sh).

# ---- Aplicação ------------------------------------------------------------
APP_ENV=local                      # local | prod
LOG_LEVEL=INFO

# ---- Usuário / canal ------------------------------------------------------
ALLOWED_NUMBER=5531999998888       # número pessoal do usuário, só dígitos
BOT_NUMBER=5531988887777           # número Vivo do bot, só dígitos (informativo)
USER_LEVEL=B1-B2                   # A2-B1 | B1-B2 | B2-C1
PRACTICE_MODE=guiado               # guiado | producao_primeiro

# ---- WAHA (gateway WhatsApp) ---------------------------------------------
WAHA_URL=http://waha:3000
WAHA_SESSION=default
WAHA_API_KEY=fake-local-key        # em prod vem do Secret Manager
WAHA_DASHBOARD_PASSWORD=fake-local # em prod vem do Secret Manager
# Assinatura HMAC dos webhooks (opcional; em prod vem do Secret Manager):
WAHA_HOOK_HMAC_KEY=

# ---- IA -------------------------------------------------------------------
LLM_PROVIDER=vertex_gemini         # vertex_gemini (padrão) | anthropic
GCP_PROJECT_ID=meu-projeto-local
VERTEX_LOCATION=global
# Modelo Gemini (GA, fora da família 2.5, que será aposentada em outubro/2026).
# GEMINI_MODEL_EVAL (opcional) é um modelo maior só para avaliar frases.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_EVAL=
# Só com LLM_PROVIDER=anthropic (em prod vem do Secret Manager):
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Storage --------------------------------------------------------------
EXPORT_BUCKET=meu-projeto-vocabot-exports
